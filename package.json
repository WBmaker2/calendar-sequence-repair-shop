{
  "name": "calendar-sequence-repair-shop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "초등 1~2학년 달력 날짜·요일 순서 복원 연습 앱 (정적, 무서버, 무학생 개인정보)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "test:a11y": "vitest run tests/a11y",
    "test:e2e": "playwright test",
    "check:lines": "node scripts/check-file-lines.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:run && npm run test:a11y && npm run check:lines && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.54.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.10.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vitest-axe": "1.0.0-pre.5"
  }
}
